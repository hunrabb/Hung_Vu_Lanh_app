DB_HOST=your-service.aivencloud.com
# Replace with the actual port in your Aiven service overview.
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=your_api_database_user
DB_PASSWORD=replace_with_your_database_password
PORT=3000
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_TTL_SECONDS=1800

# Confirm the database ID separately before migration.
FIREBASE_PROJECT_ID=mobileapp-db88e
# FIRESTORE_DATABASE_ID=(default)
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/service-account.json

# Optional browser origins; omit for local development. No trailing slash.
# CORS_ORIGINS=http://localhost:8080,https://your-app.example.com
